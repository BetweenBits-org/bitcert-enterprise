{
  "policyVersion": "corridor-vn-sg-v1",
  "currencies": ["USD", "USDC", "VND", "SGD"],
  "unitOfAccountGroups": [["USD", "USDC"]],
  "amountTolerance": "0.00",
  "amountToleranceBps": 0,
  "fxReference": "bank-locked-quote",
  "settlementWindow": "P2D",
  "fees": { "deductible": false, "maxBps": 0 },
  "splitPayments": { "allowed": false, "aggregate": false },
  "partyIDMatch": "normalized",
  "sourceTrustLevel": "ATTESTED",
  "requiredElements": [
    "chainTransfer", "payoutReceipts", "bankInstruction", "commercialDocs",
    "travelRule", "bankApproval"
  ],
  "signatureRequiredElements": [
    "payoutReceipts", "bankInstruction", "commercialDocs", "travelRule", "bankApproval"
  ],
  "regulatoryFields": [
    "originator", "beneficiary", "amount", "currency", "purpose",
    "jurisdictionFrom", "jurisdictionTo", "chainTxRef",
    "originatorAddress", "beneficiaryAddress", "invoiceRef", "payoutRef", "iso20022"
  ],
  "requireTravelRulePreflight": true,
  "enforceFxQuoteWindow": true,
  "settlementIdRequiredIn": ["bankInstruction", "bankApproval", "payoutReceipts", "chainTransfer"]
}
