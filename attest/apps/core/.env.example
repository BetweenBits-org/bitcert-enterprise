# ── StoneHash Attest Core ──────────────────────────────────────────────────
# Copy to .env and edit. Nothing below has a value compiled into the code, so
# the same tree runs on this test box and on a production instance unchanged.

# test → sk_test_ keys, self-serve sandbox sign-up enabled
# live → sk_live_ keys, sign-up disabled (keys issued per contract)
STONEHASH_ENV=test

# Where the SQLite file and any future state live. One directory to back up,
# one directory to copy when this moves to another instance.
STONEHASH_DATA_DIR=./.data

# 127.0.0.1 keeps the service behind a reverse proxy. Only widen this
# deliberately — a service bound to 0.0.0.0 by default is exposed by accident.
HOST=127.0.0.1
PORT=8787

# regtest → private chain. Anchors verify offline (links A/B/C1) but a third
#           party cannot confirm public-chain inclusion (C2).
# mainnet → public chain. Requires a funded wallet on the node below.
ANCHOR_BACKEND=regtest

# bitcoind holds the wallet and does the funding and signing, so no private key
# ever enters this process.
BITCOIND_URL=http://127.0.0.1:18443
BITCOIND_USER=
BITCOIND_PASSWORD=
BITCOIND_WALLET=attest

# Seal a batch when it reaches this many leaves, or when the window elapses.
BATCH_MAX_LEAVES=1024
BATCH_FLUSH_INTERVAL_MS=10000

# In-process batcher cadence. 0 disables it (for one-shot or read-only runs).
WORKER_TICK_MS=2000

# Absolute path to the built Playground (apps/playground/dist). Empty = not served.
# The Playground is a pure client: it verifies in the browser and calls no API.
PLAYGROUND_DIR=

# Absolute path to the built Sandbox Console (apps/console/dist). Empty = not served.
# Self-serve accounts for people evaluating the product. Sandbox-only: the
# routes refuse to answer when STONEHASH_ENV=live, because production access is
# provisioned per contract.
CONSOLE_DIR=
CONSOLE_ENABLED=1
# Attestations one org may create per calendar month. There is no retention
# setting: an organisation's records are kept until it asks for them to be
# deleted, here and in production alike. Only the free tier expires
# (PUBLIC_ANCHOR_RETENTION_DAYS).
CONSOLE_MONTHLY_QUOTA=1000
# The price list the console's billing card is computed from, as JSON: one
# currency (ISO 4217), and per product a monthly fee plus a unit price on what
# it meters. Unset = the sandbox, everything 0, shown as "no charge". A typo
# refuses to boot rather than billing at zero. Example:
# CONSOLE_PRICING={"currency":"KRW","attest":{"monthly_fee":300000,"per_anchor":100},"por":{"monthly_fee":500000,"per_snapshot":0},"remit":{"monthly_fee":0,"per_settlement":1500}}
CONSOLE_PRICING=
# Mark the session cookie Secure. REQUIRED behind HTTPS; on plain HTTP the
# browser silently discards the cookie and the console looks broken.
COOKIE_SECURE=

# Absolute path to the built Developer Hub (apps/docs/dist). Empty = not served.
# Also a pure client, and it renders completely without this service — a docs
# site that goes blank when the API is down is useless exactly when it is needed.
DOCS_DIR=

# ── Remit (cross-border settlement rail) ──────────────────────────────────
# CAIP-2 label of the chain USDC settles on, written into every settlement's
# chainTransfer evidence. The sandbox rail is a local Anvil chain.
REMIT_CHAIN_LABEL=eip155:31337
# Per-transaction explorer link for that chain, with {tx} where the hash goes.
# Leave it unset in the sandbox: Anvil has no explorer, and a link that always
# fails reads as the transfer being missing rather than the explorer being
# wrong. On a public chain set e.g. https://etherscan.io/tx/{tx}. It must start
# with http:// or https:// and contain the literal {tx}, or boot refuses.
REMIT_EXPLORER_TX_URL=
# The settlement chain's JSON-RPC, used read-only by the server to answer
# "what does the chain say about this transfer" (block, confirmations,
# success) in the console tracker. Never sent to the browser. Defaults to the
# local test chain in the sandbox; live must set it. It must be an http:// or
# https:// URL with no user:pass@ in it, or boot refuses (fetch will not send
# userinfo credentials, and the error it throws instead would quote them).
REMIT_CHAIN_RPC=

# Honour x-forwarded-for when rate limiting. Set to 1 ONLY behind a proxy —
# trusting it otherwise lets any caller forge the header and skip the limit.
TRUST_PROXY=

# Sandbox key minting is unauthenticated by design (self-serve, no approval
# queue). These cap the cost of that on a publicly reachable address.
SIGNUP_RATE_WINDOW_MS=3600000
SIGNUP_RATE_MAX=20

# Refuses to start on STONEHASH_ENV=live with ANCHOR_BACKEND=regtest unless 1.
# ALLOW_REGTEST_IN_LIVE=1
