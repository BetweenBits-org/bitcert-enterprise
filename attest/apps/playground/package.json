{
  "name": "@stonehash/attest-playground",
  "version": "0.1.0",
  "private": true,
  "description": "StoneHash Attest Playground \u2014 verify proof bundles entirely in the browser. No bundler, no framework, no backend.",
  "type": "module",
  "scripts": {
    "sync": "node build.mjs sync",
    "build": "node build.mjs",
    "typecheck": "node build.mjs sync && tsc -p tsconfig.json",
    "test": "node --test 'test/*.test.ts'"
  },
  "devDependencies": {
    "@stonehash/attest-verify": "workspace:*",
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3"
  }
}
